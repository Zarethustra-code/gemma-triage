# Gemma-Triage — example environment file.
# Copy to `.env` and fill in. `.env` is gitignored; NEVER commit real secrets.
#
#   cp .env.example .env
#
# Every variable here is optional. With none of them set, the app still runs:
# it opens the demo inbox and falls back to the local heuristic engine.

# ---------------------------------------------------------------------------
# Gemma 4 backend
# ---------------------------------------------------------------------------

# auto | transformers | hf_api | heuristic
#   auto         try on-device transformers, then heuristic. Only considers hf_api
#                when ALLOW_REMOTE_INFERENCE=true (see below)
#   transformers Gemma 4 locally — email content stays on this device,
#                needs requirements-local.txt
#   hf_api       Gemma 4 hosted on Hugging Face — email content is sent to an
#                external inference provider. Needs HF_TOKEN
#   heuristic    keyword fallback, no model at all, on-device
GEMMA_BACKEND=transformers

# Primary checkpoint. Lighter alternative: google/gemma-4-E2B-it
GEMMA_MODEL_ID=google/gemma-4-E4B-it

# Device map for the local backend: auto | cpu | cuda | mps
GEMMA_DEVICE=auto

# ---------------------------------------------------------------------------
# Processing location and action limits
# ---------------------------------------------------------------------------

# May email content be sent to an external inference provider? Default false.
# While this is false, GEMMA_BACKEND=auto resolves on-device only (transformers,
# then heuristic) and the hosted API is never contacted. Setting GEMMA_BACKEND=hf_api
# by name is an explicit request for remote processing and is honoured either way;
# the status bar states REMOTE whenever that is what is happening.
ALLOW_REMOTE_INFERENCE=false

# Hard ceiling on tool calls accepted from a single email. Email content is
# untrusted: this is what makes "create ten calendar events" in a message body
# a non-event. Default 5.
MAX_ACTIONS_PER_EMAIL=5

# ---------------------------------------------------------------------------
# Hugging Face
# ---------------------------------------------------------------------------

# Needed to download gated Gemma weights and to use the hf_api backend.
# Create one at https://huggingface.co/settings/tokens
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Gmail connector (optional — the demo inbox needs none of this)
# ---------------------------------------------------------------------------

# Path to the OAuth *client* JSON downloaded from Google Cloud Console
# (APIs & Services -> Credentials -> Create OAuth client ID -> Desktop app).
GOOGLE_CREDENTIALS_FILE=credentials.json

# Where the cached user token is written after the first consent. Gitignored.
GOOGLE_TOKEN_FILE=token.json

# IANA timezone stamped onto generated Google Calendar payloads.
GOOGLE_CALENDAR_TIMEZONE=UTC

# ---------------------------------------------------------------------------
# Gradio server
# ---------------------------------------------------------------------------

GRADIO_SERVER_NAME=0.0.0.0
GRADIO_SERVER_PORT=7860
